#Область ОбработчикиКомандФормы

&НаКлиенте
// Обработчик команды формы Заполнить.
// Делегирует выполнение серверной процедуре, которая вызывает
// экспортную процедуру Заполнить модуля объекта обработки.
//
// Параметры:
//  Команда - КомандаФормы - команда формы, инициировавшая обработчик.
Процедура Заполнить(Команда)

	ЗаполнитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
// Серверный обработчик: получает объект обработки из реквизита формы
// и вызывает процедуру заполнения тестовых данных в его модуле.
// Модуль объекта работает на сервере, поэтому прямой клиентский
// вызов недопустим — используется эта прослойка.
Процедура ЗаполнитьНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.Заполнить();

КонецПроцедуры

#КонецОбласти
